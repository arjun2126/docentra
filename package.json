{
  "name": "docentra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --dir tests/unit",
    "lint": "eslint .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:check": "node --env-file-if-exists=.env scripts/check-db.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env prisma/seed.mjs",
    "db:verify": "node --env-file-if-exists=.env scripts/verify-seed.mjs",
    "test:integration": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run --dir tests/integration --no-file-parallelism",
    "test:e2e": "node --env-file-if-exists=.env scripts/e2e.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "^15",
    "pdf-lib": "^1.17.1",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@prisma/client": "^6",
    "@types/node": "^22",
    "@types/pg": "^8.11.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "pg": "^8.13.1",
    "postcss": "^8.4.49",
    "prisma": "^6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.8"
  }
}
